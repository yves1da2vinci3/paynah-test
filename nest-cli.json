{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/comptes/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": "tsc",
    "tsConfigPath": "apps/comptes/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/comptes",
  "projects": {
    "comptes": {
      "type": "application",
      "root": "apps/comptes",
      "entryFile": "main",
      "sourceRoot": "apps/comptes/src",
      "compilerOptions": {
        "tsConfigPath": "apps/comptes/tsconfig.app.json"
      }
    },
    "paiements": {
      "type": "application",
      "root": "apps/paiements",
      "entryFile": "main",
      "sourceRoot": "apps/paiements/src",
      "compilerOptions": {
        "tsConfigPath": "apps/paiements/tsconfig.app.json"
      }
    },
    "transactions": {
      "type": "application",
      "root": "apps/transactions",
      "entryFile": "main",
      "sourceRoot": "apps/transactions/src",
      "compilerOptions": {
        "tsConfigPath": "apps/transactions/tsconfig.app.json"
      }
    },
    "shared-kernel": {
      "type": "library",
      "root": "libs/shared-kernel",
      "entryFile": "index",
      "sourceRoot": "libs/shared-kernel/src",
      "compilerOptions": {
        "tsConfigPath": "libs/shared-kernel/tsconfig.lib.json"
      }
    }
  }
}

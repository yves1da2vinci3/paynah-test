{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": [
      "node"
    ],
    "paths": {
      "@app/shared-kernel": [
        "./libs/shared-kernel/src"
      ],
      "@app/shared-kernel/*": [
        "./libs/shared-kernel/src/*"
      ]
    }
  },
  "files": [],
  "references": [
    {
      "path": "./apps/comptes/tsconfig.app.json"
    },
    {
      "path": "./apps/paiements/tsconfig.app.json"
    },
    {
      "path": "./apps/transactions/tsconfig.app.json"
    },
    {
      "path": "./libs/shared-kernel/tsconfig.lib.json"
    }
  ]
}